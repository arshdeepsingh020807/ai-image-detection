# Backend (all optional; defaults shown)
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
RATE_LIMIT_PER_MINUTE=30
ALLOWED_ORIGINS=http://localhost:5173
MODEL_DIR=artifacts/models
METRICS_DIR=artifacts/metrics
FRONTEND_DIST=frontend/dist
# Render sits behind a proxy: trust the rightmost X-Forwarded-For entry for rate limiting
TRUST_PROXY_HEADERS=false
# Header naming the visitor when TRUST_PROXY_HEADERS is on (Render/Cloudflare: true-client-ip)
CLIENT_IP_HEADER=
# A 40 MP decode needs a few hundred MB; keep 1 on a 512 MB instance
MAX_CONCURRENT_INFERENCES=1
INFERENCE_THREADS=1
LOG_LEVEL=INFO
# Kaggle auth is read from ~/.kaggle/access_token or KAGGLE_API_TOKEN, never from this repo.
